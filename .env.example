# --- Docker Compose Environment Variables ---

# User Service
DATABASE_URL=postgres://user:password@postgres:5432/db
JWT_SECRET=your-super-secret-key-that-is-long-and-secure

# Generation Service
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Worker
# (Uses the same as Generation Service)

# Profiling Service
# (Uses the same DATABASE_URL as User Service)

# Asset Server
ASSET_SERVER_PORT=8082

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COLLABORATION_URL=http://localhost:8084

# --- Terraform Environment Variables (for production) ---
# These would typically be set in a secure CI/CD environment, not in a .env file.
# TF_VAR_aws_access_key_id=...
# TF_VAR_aws_secret_access_key=...
# TF_VAR_db_password=...
# TF_VAR_jwt_secret_prod=...
# TF_VAR_ecr_repository_url=...
# TF_VAR_image_tag=...
# TF_VAR_eks_role_arn=...